<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MatterControllerApp.Pages.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid MaxWidth="840" Padding="32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Connect a device" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Use a sharing code from the device's current controller, or commission a development device over Bluetooth LE."
                           TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="14">
                <TextBox x:Name="SharingCodeBox" Header="Sharing code"
                         PlaceholderText="Manual code or MT: QR payload"
                         Text="{x:Bind ViewModel.SharingCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Name="ConnectButton" Content="Connect with sharing code"
                        HorizontalAlignment="Left" Command="{x:Bind ViewModel.ConnectWithSharingCodeCommand}" />

                <TextBlock Text="Bluetooth LE development commissioning" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Setup PIN" Value="{x:Bind ViewModel.SetupPinCode, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Column="1" Header="Long discriminator" Value="{x:Bind ViewModel.LongDiscriminator, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                </Grid>
                <Button x:Name="BleButton" Content="Commission over Bluetooth LE"
                        HorizontalAlignment="Left" Command="{x:Bind ViewModel.CommissionBleCommand}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock x:Name="ConnectStatusText" Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
