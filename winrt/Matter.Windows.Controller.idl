    enum MatterCameraStage
    {
        Validation = 0,
        Descriptor = 1,
        Privacy = 2,
        StreamSelection = 3,
        Signaling = 4,
        IceCandidates = 5,
        SessionEnd = 6,
        Discovery = 7,
        Capabilities = 8,
        StreamAllocation = 9,
        StreamDeallocation = 10
    };

    enum MatterCameraFailureCategory
    {
        Unknown = 0,
        InvalidInput = 1,
        Unsupported = 2,
        AccessDenied = 3,
        PrivacyEnabled = 4,
        ResourceExhausted = 5,
        Timeout = 6,
        ConnectionFailure = 7,
        MalformedData = 8,
        InvalidState = 9,
        DynamicConstraintError = 10,
        ConstraintError = 11,
        CommandRejected = 12
    };

