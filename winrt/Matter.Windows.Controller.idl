    enum CommissioningStage
    {
        Discovering = 0,
        Connecting = 1,
        EstablishingPase = 2,
        AttestingDevice = 3,
        ConfiguringDevice = 4,
        Completing = 5,
        Complete = 6
    };

    runtimeclass ControllerOptions
