<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CsWinRTIncludes>Matter.Windows.Controller</CsWinRTIncludes>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <ApplicationManifest>..\..\winrt\nuget\Matter.Windows.Controller.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Matter.Windows.Controller" Version="$(MatterControllerPackageVersion)" />
    <Compile Include="..\..\samples\ControllerApp\ApiSurfaceCompileChecks.cs" Link="ApiSurfaceCompileChecks.cs" />
  </ItemGroup>
</Project>
