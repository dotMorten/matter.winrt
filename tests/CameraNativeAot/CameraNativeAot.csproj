<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);MATTER_CAMERA_DEVELOPMENT</DefineConstants>
    <CsWinRTIncludes>Matter.Windows.Controller</CsWinRTIncludes>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MatterWinrtOutput Condition="'$(MatterWinrtOutput)' == ''">$(MSBuildThisFileDirectory)..\..\out\win-winrt-x64</MatterWinrtOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\samples\ControllerApp\Camera\CameraAllocationOwnership.cs" Link="CameraAllocationOwnership.cs" />
    <Compile Include="..\..\samples\ControllerApp\Camera\CameraAudioProfiles.cs" Link="CameraAudioProfiles.cs" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <CsWinRTInputs Include="$(MatterWinrtOutput)\Matter.Windows.Controller.winmd" Condition="'$(MatterControllerPackageVersion)' == ''" />
    <PackageReference Include="Matter.Windows.Controller" Version="$(MatterControllerPackageVersion)" Condition="'$(MatterControllerPackageVersion)' != ''" />
    <Content Include="$(MatterWinrtOutput)\Matter.Windows.Controller.dll" Condition="'$(MatterControllerPackageVersion)' == ''">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MatterWinrtOutput)\CameraNativeAotFixture.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
